{"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_channel_setup","doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_project_config"],"title":"Setup","anchor":"Setup"}],"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"For security reasons, chat history by default has a temporary nature and gets killed when providing another credentials into "},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","isActive":true,"type":"reference"},{"type":"text","text":"."},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","isActive":true,"type":"reference"},{"type":"text","text":"."},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/setup(widgetID:clientIdentity:)","isActive":true,"type":"reference"},{"type":"text","text":", or by calling "},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","isActive":true,"type":"reference"},{"type":"text","text":"."},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","isActive":true,"type":"reference"},{"type":"text","text":"."},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/shutDown()"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It means, for example, if your client logs-out and then logs-in again, you may see him as entirely new client."},{"type":"text","text":"\n"},{"type":"text","text":"Even in case he uses the same login credentials, and even in case you provide the same user_token for him into SDK."}],"type":"paragraph"},{"inlineContent":[{"text":"To keep chat history alive between login sessions, you have to generate JWT token and use it as user_token.","type":"text"},{"text":"\n","type":"text"},{"text":"Below, we explain how to do that.","type":"text"}],"type":"paragraph"},{"level":2,"text":"#1: Prepare secret","type":"heading","anchor":"1-Prepare-secret"},{"inlineContent":[{"type":"text","text":"First, you need to create your global "},{"code":"secret","type":"codeVoice"},{"type":"text","text":" which you’ll use for generating JWT tokens."},{"type":"text","text":"\n"},{"type":"text","text":"Please create it accordingly to RFC 7519, with length of 256 bit."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Then, place this secret into “JWT Settings” screen of your Mobile SDK channel options."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"You may found this resource useful to generate, sign, and check JWT tokens: ","type":"text"},{"type":"reference","identifier":"https:\/\/jwt.io\/","isActive":true}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"level":2,"text":"#2: Generate token","type":"heading","anchor":"2-Generate-token"},{"inlineContent":[{"type":"text","text":"JWT tokens you will generate for your clients, must:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"contain unique “id” field for each individual client","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"be encrypted using your "},{"code":"secret","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Minimal JWT payload must contain “id” field which acts like a client identifier, so here is example of such JWT payload:"}],"type":"paragraph"},{"code":["{","    \"id\": \"egor531@example.com\"","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"Finally, you should feed your JWT as userToken parameter into:"},{"type":"text","text":"\n"},{"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","isActive":true},{"type":"text","text":"."},{"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","isActive":true},{"type":"text","text":"."},{"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/setup(widgetID:clientIdentity:)","isActive":true}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For security reasons, you’d better generate JWT tokens on your back-end,"},{"type":"text","text":"\n"},{"type":"text","text":"rather than doing it directly in the mobile app (because your "},{"type":"codeVoice","code":"secret"},{"type":"text","text":" might be stolen)"}]}],"type":"aside","name":"Important","style":"important"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/jivosdk\/common_user_token"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/jivosdk\/common_user_token"]}],"hierarchy":{"paths":[["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK"]]},"identifier":{"url":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_user_token","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"modules":[{"name":"JivoSDK"}],"roleHeading":"Article","role":"article","title":"User Token and JWT"},"abstract":[{"type":"text","text":"Required for keeping chat history alive"}],"references":{"doc://org.cocoapods.JivoSDK/documentation/JivoSDK/Jivo":{"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","title":"Jivo","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Jivo"}],"navigatorTitle":[{"kind":"identifier","text":"Jivo"}],"url":"\/documentation\/jivosdk\/jivo","abstract":[]},"doc://org.cocoapods.JivoSDK/documentation/JivoSDK/common_channel_setup":{"type":"topic","kind":"article","abstract":[{"text":"Mobile SDK","type":"text"}],"id