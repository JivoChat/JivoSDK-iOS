jivochat.github.io\/JivoSDK-iOS\/"}]}],"name":"Important","style":"important","type":"aside"},{"items":[{"content":[{"text":"Quick start","level":2,"anchor":"Quick-start","type":"heading"},{"inlineContent":[{"text":"First, start SDK session after you have authorized your client wherever in your logic (like example below):","type":"text"},{"text":"\n","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/jivochat.github.io\/JivoSDK-iOS\/documentation\/jivosdk\/common_user_token"}],"type":"paragraph"},{"code":["func handleUserLogin() {","    let client = Jivo.session.setup(","        widgetID: \"YOUR_WIDGET_ID\",","        clientIdentity: .jwt(\"USER_TOKEN_IN_JWT_FORMAT\")","    )","","    client.setClientInfo(...) \/\/ optional","    client.setCustomData(...) \/\/ optional","","    client.listenToUnreadCounter { number in","        \/\/ read updates here","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Second, present the SDK onto screen whenever you need it (like example below):","type":"text"}],"type":"paragraph"},{"code":["\/\/ UIKit","func handleSupportButtonTap() {","    if let navigationController {","        Jivo.display.push(into: navigationController)","    }","    else {","        Jivo.display.present(over: self)","    }","}","","\/\/ SwiftUI","var body: some View {","    Text(\"Tech Support\")","        .fullScreenCover(isPresented: $shouldPresentChat) {","            Jivo.display.makeScreen(.modal)","        }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To support Push Notifications, you should provide us Push Token (like example below):","type":"text"}],"type":"paragraph"},{"code":["func application(_ application: UIApplication, didRegisterForRemoteNotificationsWithDeviceToken deviceToken: Data) {","    \/\/ ... your existing logic ...","","    Jivo.notifications.setPushToken(data: deviceToken)","}","","func application(_ application: UIApplication, didFailToRegisterForRemoteNotificationsWithError error: Error) {","    \/\/ ... your existing logic ...","","    Jivo.notifications.setPushToken(error: error)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"To handle and display incoming notifications, please implement three another methods (like example below):"}],"type":"paragraph"},{"code":["func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","    \/\/ ... your existing logic ...","","    UNUserNotificationCenter.current().delegate = self","","    if Jivo.notifications.handleLaunch(options: launchOptions) {","        Jivo.display.present(over: rootViewController)","    }","    ","    return true","}","","func application(_ application: UIApplication, didReceiveRemoteNotification userInfo: [AnyHashable : Any], fetchCompletionHandler completionHandler: @escaping (UIBackgroundFetchResult) -> Void) {","    if let result = Jivo.notifications.didReceiveRemoteNotification(userInfo: userInfo) {","        completionHandler(result)","        return","    }","","    \/\/ ... your existing logic ...","}","","func userNotificationCenter(_ center: UNUserNotificationCenter, willPresent notification: UNNotification, withCompletionHandler completionHandler: @escaping (UNNotificationPresentationOptions) -> Void) {","    if let options = Jivo.notifications.willPresent(notification: notification, preferableOptions: .banner) {","        completionHandler(options)","        return","    }","","    \/\/ ... your existing logic ...","}","","func userNotificationCenter(_ center: UNUserNotificationCenter, didReceive response: UNNotificationResponse, withCompletionHandler completionHandler: @escaping () -> Void) {","    if Jivo.notifications.didReceive(response: response) {","        Jivo.display.present(over: rootViewController)","        completionHandler()","    }","","    \/\/ ... your existing logic ...","}"],"syntax":"swift","type":"codeListing"}]},{"content":[{"level":2,"text":"May be interesting for you:","type":"heading","anchor":"May-be-interesting-for-you"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/jivochat.github.io\/JivoSDK-iOS\/tutorials\/jivosdk\/native_usage_basics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"text":"User token and history","type":"text"}],"type":"reference","identifier":"https:\/\/jivochat.github.io\/JivoSDK-iOS\/documentation\/jivosdk\/common_user_token","isActive":true,"overridingTitle":"User token and history"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/jivochat.github.io\/JivoSDK-iOS\/documentation\/jivosdk\/jvdisplaycontroller","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/jivochat.github.io\/JivoSDK-iOS\/documentation\/jivosdk\/common_project_config\/#Localization","isActive":true,"type":"reference"}]}]}],"type":"unorderedList"}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/debugging","doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/display","doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/notifications","doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session"],"generated":true,"anchor":"Type-Properties"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/jivosdk\/jivo"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/jivosdk\/jivo"]}],"kind":"symbol","references":{"doc://org.cocoapods.JivoSDK/documentation/JivoSDK/Jivo/session":{"title":"session","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Namespace for managing user session"}],"url":"\/documentati