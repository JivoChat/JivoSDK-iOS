{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/jivosdk\/common_user_token"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/jivosdk\/common_user_token"]}],"seeAlsoSections":[{"anchor":"Setup","title":"Setup","generated":true,"identifiers":["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_channel_setup","doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_project_config"]}],"abstract":[{"type":"text","text":"Required for keeping chat history alive"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_user_token"},"kind":"article","metadata":{"modules":[{"name":"JivoSDK"}],"title":"User Token and JWT","role":"article","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"For security reasons, chat history by default has a temporary nature and gets killed when providing another credentials into ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","type":"reference"},{"text":".","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","type":"reference"},{"text":".","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/setup(widgetID:clientIdentity:)","type":"reference"},{"text":", or by calling ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","type":"reference"},{"text":".","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","type":"reference"},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/shutDown()","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It means, for example, if your client logs-out and then logs-in again, you may see him as entirely new client."},{"type":"text","text":"\n"},{"type":"text","text":"Even in case he uses the same login credentials, and even in case you provide the same user_token for him into SDK."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To keep chat history alive between login sessions, you have to generate JWT token and use it as user_token."},{"type":"text","text":"\n"},{"type":"text","text":"Below, we explain how to do that."}],"type":"paragraph"},{"anchor":"1-Prepare-secret","type":"heading","level":2,"text":"#1: Prepare secret"},{"inlineContent":[{"text":"First, you need to create your global ","type":"text"},{"code":"secret","type":"codeVoice"},{"text":" which you’ll use for generating JWT tokens.","type":"text"},{"text":"\n","type":"text"},{"text":"Please create it accordingly to RFC 7519, with length of 256 bit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Then, place this secret into “JWT Settings” screen of your Mobile SDK channel options.","type":"text"}],"type":"paragraph"},{"style":"tip","content":[{"inlineContent":[{"type":"text","text":"You may found this resource useful to generate, sign, and check JWT tokens: "},{"identifier":"https:\/\/jwt.io\/","type":"reference","isActive":true}],"type":"paragraph"}],"type":"aside","name":"Tip"},{"anchor":"2-Generate-token","type":"heading","level":2,"text":"#2: Generate token"},{"inlineContent":[{"text":"JWT tokens you will generate for your clients, must:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"contain unique “id” field for each individual client"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"be encrypted using your ","type":"text"},{"code":"secret","type":"codeVoice"}]}]}]},{"inlineContent":[{"text":"Minimal JWT payload must contain “id” field which acts like a client identifier, so here is example of such JWT payload:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["{","    \"id\": \"egor531@example.com\"","}"]},{"inlineContent":[{"type":"text","text":"Finally, you should feed your JWT as userToken parameter into:"},{"type":"text","text":"\n"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo"},{"type":"text","text":"."},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session"},{"type":"text","text":"."},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/setup(widgetID:clientIdentity:)"}],"type":"paragraph"},{"style":"important","content":[{"inlineContent":[{"text":"For security reasons, you’d better generate JWT tokens on your back-end,","type":"text"},{"text":"\n","type":"text"},{"text":"rather than doing it directly in the mobile app (because your ","type":"text"},{"code":"secret","type":"codeVoice"},{"text":" might be stolen)","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://org.cocoapods.JivoSDK/documentation/JivoSDK":{"kind":"symbol","type":"topic","abstract":[],"title":"JivoSDK","url":"\/documentation\/jivosdk","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK","role":"collection"},"doc://org.cocoapods.JivoSDK/documentation/JivoSDK/JVSessionController/shutDown()":{"navigatorTitle":[{"text":"shutDown","kind":"identifier"}],"url":"\/documentation\/jivosdk\/jvsessioncontroller\/shutdown()","abstract":[{"type":"text","text":"Closes current connection, clears the local database,"},{"type":"text","text":" "},{"type"