{"seeAlsoSections":[{"title":"Setup","identifiers":["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_channel_setup","doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_project_config"],"generated":true,"anchor":"Setup"}],"abstract":[{"type":"text","text":"Required for keeping chat history alive"}],"sections":[],"kind":"article","metadata":{"title":"User Token and JWT","modules":[{"name":"JivoSDK"}],"role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_user_token","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"For security reasons, chat history by default has a temporary nature and gets killed when providing another credentials into ","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","isActive":true,"type":"reference"},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","isActive":true,"type":"reference"},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/setup(widgetID:clientIdentity:)","isActive":true,"type":"reference"},{"text":", or by calling ","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","isActive":true,"type":"reference"},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","isActive":true,"type":"reference"},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/shutDown()","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It means, for example, if your client logs-out and then logs-in again, you may see him as entirely new client."},{"type":"text","text":"\n"},{"type":"text","text":"Even in case he uses the same login credentials, and even in case you provide the same user_token for him into SDK."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To keep chat history alive between login sessions, you have to generate JWT token and use it as user_token."},{"type":"text","text":"\n"},{"type":"text","text":"Below, we explain how to do that."}]},{"level":2,"type":"heading","text":"#1: Prepare secret","anchor":"1-Prepare-secret"},{"type":"paragraph","inlineContent":[{"text":"First, you need to create your global ","type":"text"},{"code":"secret","type":"codeVoice"},{"text":" which you’ll use for generating JWT tokens.","type":"text"},{"text":"\n","type":"text"},{"text":"Please create it accordingly to RFC 7519, with length of 256 bit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Then, place this secret into “JWT Settings” screen of your Mobile SDK channel options.","type":"text"}]},{"name":"Tip","type":"aside","content":[{"inlineContent":[{"type":"text","text":"You may found this resource useful to generate, sign, and check JWT tokens: "},{"type":"reference","identifier":"https:\/\/jwt.io\/","isActive":true}],"type":"paragraph"}],"style":"tip"},{"level":2,"type":"heading","text":"#2: Generate token","anchor":"2-Generate-token"},{"type":"paragraph","inlineContent":[{"text":"JWT tokens you will generate for your clients, must:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"contain unique “id” field for each individual client","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"be encrypted using your "},{"code":"secret","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Minimal JWT payload must contain “id” field which acts like a client identifier, so here is example of such JWT payload:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["{","    \"id\": \"egor531@example.com\"","}"]},{"inlineContent":[{"text":"Finally, you should feed your JWT as userToken parameter into:","type":"text"},{"text":"\n","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","isActive":true,"type":"reference"},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","isActive":true,"type":"reference"},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/setup(widgetID:clientIdentity:)","isActive":true,"type":"reference"}],"type":"paragraph"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"For security reasons, you’d better generate JWT tokens on your back-end,","type":"text"},{"text":"\n","type":"text"},{"text":"rather than doing it directly in the mobile app (because your ","type":"text"},{"code":"secret","type":"codeVoice"},{"text":" might be stolen)","type":"text"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/jivosdk\/common_user_token"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/jivosdk\/common_user_token"]}],"references":{"doc://org.cocoapods.JivoSDK/documentation/JivoSDK":{"type":"topic","abstract":[],"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK","url":"\/documentation\/jivosdk","kind":"symbol","title":"JivoSDK","role":"collection"},"doc://org.cocoapods.JivoSDK/documentation/JivoSDK/common_project_config":{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_project_config","role":"article","url":"\/documentation\/jivosdk\/common_project_config","title":"Setup your Project","abstract":[{"type":"text","text":"Permissions and Push Notificat