{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/jivosdk\/common_user_token"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/jivosdk\/common_user_token"]}],"abstract":[{"type":"text","text":"Required for keeping chat history alive"}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"For security reasons, chat history by default has a temporary nature and gets killed when providing another credentials into "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo"},{"type":"text","text":"."},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session"},{"type":"text","text":"."},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/setup(widgetID:clientIdentity:)"},{"type":"text","text":", or by calling "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo"},{"type":"text","text":"."},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session"},{"type":"text","text":"."},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/shutDown()"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It means, for example, if your client logs-out and then logs-in again, you may see him as entirely new client."},{"type":"text","text":"\n"},{"type":"text","text":"Even in case he uses the same login credentials, and even in case you provide the same user_token for him into SDK."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To keep chat history alive between login sessions, you have to generate JWT token and use it as user_token."},{"type":"text","text":"\n"},{"type":"text","text":"Below, we explain how to do that."}],"type":"paragraph"},{"anchor":"1-Prepare-secret","level":2,"type":"heading","text":"#1: Prepare secret"},{"inlineContent":[{"text":"First, you need to create your global ","type":"text"},{"type":"codeVoice","code":"secret"},{"text":" which you’ll use for generating JWT tokens.","type":"text"},{"text":"\n","type":"text"},{"text":"Please create it accordingly to RFC 7519, with length of 256 bit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Then, place this secret into “JWT Settings” screen of your Mobile SDK channel options.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"You may found this resource useful to generate, sign, and check JWT tokens: "},{"identifier":"https:\/\/jwt.io\/","type":"reference","isActive":true}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"anchor":"2-Generate-token","level":2,"type":"heading","text":"#2: Generate token"},{"inlineContent":[{"type":"text","text":"JWT tokens you will generate for your clients, must:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"contain unique “id” field for each individual client","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"be encrypted using your ","type":"text"},{"code":"secret","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Minimal JWT payload must contain “id” field which acts like a client identifier, so here is example of such JWT payload:","type":"text"}],"type":"paragraph"},{"code":["{","    \"id\": \"egor531@example.com\"","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"Finally, you should feed your JWT as userToken parameter into:","type":"text"},{"text":"\n","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo","type":"reference","isActive":true},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/Jivo\/session","type":"reference","isActive":true},{"text":".","type":"text"},{"identifier":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/JVSessionController\/setup(widgetID:clientIdentity:)","type":"reference","isActive":true}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For security reasons, you’d better generate JWT tokens on your back-end,","type":"text"},{"text":"\n","type":"text"},{"text":"rather than doing it directly in the mobile app (because your ","type":"text"},{"code":"secret","type":"codeVoice"},{"text":" might be stolen)","type":"text"}]}],"type":"aside","style":"important","name":"Important"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK"]]},"metadata":{"title":"User Token and JWT","modules":[{"name":"JivoSDK"}],"roleHeading":"Article","role":"article"},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"generated":true,"title":"Setup","identifiers":["doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_channel_setup","doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_project_config"],"anchor":"Setup"}],"identifier":{"url":"doc:\/\/org.cocoapods.JivoSDK\/documentation\/JivoSDK\/common_user_token","interfaceLanguage":"swift"},"references":{"https://jwt.io/":{"titleInlineContent":[{"type":"text","text":"jwt.io"}],"identifier":"https:\/\/jwt.io\/","title":"jwt.io","type":"link","url":"https:\/\/jwt.io\/"},"doc://org.cocoapods.JivoSDK/documentation/JivoSDK/Jivo/session":{"title":"session","kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"session","kind":"identifier"},{"text":": ","kind":"text"},{"text":"JVSessionController","preciseIdentifier":"c:@M@JivoSDK@objc(cs)JVSessionControll